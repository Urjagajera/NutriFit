# ====================================================================
# NutriFit - Environment Configuration Template
# Copy this file to '.env' and update the values for your local system.
# ====================================================================

# Secret key for Flask session signing and CSRF tokens
# You can generate a secure key in Python using:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_random_key_here

# Database connection URL for SQLAlchemy:
# Format: mysql+pymysql://<db_user>:<db_password>@<db_host>:<db_port>/<database_name>
#
# NOTE: If your MySQL password contains special characters (like @, :, /, #, %, etc.),
# you MUST URL-encode them:
#   @  ->  %40
#   :  ->  %3A
#   /  ->  %2F
#   #  ->  %23
#   %  ->  %25
#   ,  ->  %2C
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/nutrifit_db

# Flask Environment ('development' or 'production')
FLASK_ENV=development
